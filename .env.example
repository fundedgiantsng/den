# Environment Parity Configuration (Placeholders only - never commit real secrets)
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://fg_admin:fg_secret_password@localhost:5432/fundedgiants_dev?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Session / JWT
JWT_SECRET="development-insecure-secret-min-32-chars-key-only"
JWT_EXPIRATION="7d"

# External Integrations (Sandbox / Test Contracts)
# WooCommerce
WOOCOMMERCE_API_URL="https://fundedgiants.local/wp-json/wc/v3"
WOOCOMMERCE_CONSUMER_KEY=""
WOOCOMMERCE_CONSUMER_SECRET=""
WOOCOMMERCE_WEBHOOK_SECRET=""

# SteraTrader
STERATRADER_API_URL="https://api.steratrader.com"
STERATRADER_API_KEY=""
STERATRADER_ACCOUNT_GROUP="FG-Standard"

# Notifications
EMAIL_PROVIDER="smtp"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fundedgiants.com"

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
