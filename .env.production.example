# ==============================================================================
# FundedGiants Production Environment Configuration (.env.production)
# Target Server: OVHcloud Production Host
# Authoritative Domains:
#   - Landing / WordPress:  https://fundedgiants.ng
#   - Trader Dashboard:     https://trader.fundedgiants.ng
#   - Admin Operations:     https://admin.fundedgiants.ng
#   - Backend REST & WS:    https://api.fundedgiants.ng
# ==============================================================================

NODE_ENV=production
PORT=4000
APP_URL=https://trader.fundedgiants.ng
ADMIN_URL=https://admin.fundedgiants.ng
API_URL=https://api.fundedgiants.ng

# --- 1. Database & Cache Infrastructure ---
POSTGRES_USER=fg_prod_admin
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=fundedgiants_prod
DATABASE_URL=postgresql://fg_prod_admin:YOUR_STRONG_POSTGRES_PASSWORD@postgres:5432/fundedgiants_prod?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD

# --- 2. Security & Session Secrets ---
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_JWT
COOKIE_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_COOKIES

# --- 3. SteraTrader Production Broker Integration ---
# FundedGiants uses SteraTrader institutional liquidity rails (No MT5)
STERATRADER_API_URL=https://api.steratrader.com/v1
STERATRADER_API_KEY=YOUR_LIVE_STERATRADER_API_KEY
STERATRADER_WEBHOOK_SECRET=YOUR_LIVE_STERATRADER_WEBHOOK_SECRET
STERATRADER_SERVER_NAME=FundedGiants-Live

# --- 4. Nomba Direct Nigerian Banking Rails ---
# Powers dedicated NUBAN virtual accounts (Fundedgiants/<Name>) & manual payout transfers
NOMBA_CLIENT_ID=client_live_YOUR_NOMBA_CLIENT_ID
NOMBA_CLIENT_SECRET=sec_live_YOUR_NOMBA_CLIENT_SECRET
NOMBA_ACCOUNT_ID=acc_YOUR_NOMBA_PARENT_ACCOUNT_UUID
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_WEBHOOK_SECRET=YOUR_NOMBA_WEBHOOK_SIGNING_SECRET

# --- 5. Ninja.ng Hosted KYC Engine ---
# Powers biometric selfie, BVN verification, and auto-provisions Nomba virtual accounts
NINJA_KYC_BASE_URL=https://api.ninja.ng/v1
NINJA_KYC_API_KEY=live_ninja_YOUR_API_KEY
NINJA_KYC_CLIENT_ID=YOUR_NINJA_CLIENT_ID
NINJA_KYC_SECRET_KEY=YOUR_NINJA_SECRET_KEY
NINJA_KYC_WEBHOOK_SECRET=YOUR_NINJA_WEBHOOK_SECRET
NINJA_KYC_REDIRECT_URL=https://trader.fundedgiants.ng/dashboard/profile?kyc=callback

# --- 6. WordPress & WooCommerce Webhook Dispatcher ---
# Syncs challenge purchases, perpetual affiliate links, and overage credits
WOOCOMMERCE_WEBHOOK_SECRET=YOUR_WOOCOMMERCE_SHARED_SECRET
WOOCOMMERCE_API_URL=https://fundedgiants.ng
WOOCOMMERCE_CONSUMER_KEY=ck_YOUR_WOOCOMMERCE_CONSUMER_KEY
WOOCOMMERCE_CONSUMER_SECRET=cs_YOUR_WOOCOMMERCE_CONSUMER_SECRET

# --- 7. Transactional Email & Notifications (Brevo) ---
BREVO_API_KEY=xkeysib-YOUR_LIVE_BREVO_API_KEY
SMTP_FROM=support@fundedgiants.ng

# --- 8. SMS & WhatsApp OTP Gateway (Robase) ---
ROBASE_API_KEY=YOUR_ROBASE_PRODUCTION_API_KEY

# --- 9. Support Concierge & WhatsApp Line ---
SUPPORT_WHATSAPP_PHONE=2348000000000
